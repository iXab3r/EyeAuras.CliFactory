{
  "name": "@eyeauras/random-pw-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RANDOM.ORG website automation example",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "random-pw-cli": "./dist/src/bin.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/bin.js",
    "test:compiled": "node --test dist/tests/*.test.js",
    "pretest:integration": "npm run build --prefix ../..",
    "test:integration": "node dist/integration-tests/profile-proof.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@eyeauras/cli-factory": "0.1.0",
    "@eyeauras/cli-factory-ipc": "0.1.0",
    "@eyeauras/cli-factory-playwright": "0.1.0",
    "@eyeauras/random-common": "0.1.0"
  }
}
