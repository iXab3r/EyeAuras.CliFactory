        "nonblank": 20,
        "body": "export async function uploadIssueAttachment(\n  connection: Connection,\n  issueID: string,\n  filePath: string,\n): Promise<YouTrackObject[] | null> {\n  const path = `${issuePath(issueID)}/attachments`;\n  requiredText(filePath, \"file path\");\n  let file: Blob;\n  try {\n    if (!(await fs.promises.stat(filePath)).isFile()) {\n      throw new Error();\n    }\n    file = await fs.openAsBlob(filePath);\n  } catch {\n    throw new Error(\"YouTrack upload requires a readable regular file.\");\n  }\n  const form = new FormData();\n  form.append(\"upload1\", file, basename(filePath));\n  return uploadObjectCollection(connection, path, form, attachmentFields);\n}"
      },
