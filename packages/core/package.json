{
  "name": "@eyeauras/cli-factory",
  "version": "0.1.0",
  "description": "Reusable primitives for consistent, AI-friendly TypeScript CLIs.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test:compiled": "node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.2"
  }
}
