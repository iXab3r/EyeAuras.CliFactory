{
  "name": "@eyeauras/cli-factory",
  "version": "0.2.0",
  "description": "Reusable primitives for consistent, AI-friendly TypeScript CLIs.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js"
    },
    "./proof": {
      "types": "./dist/src/proof.d.ts",
      "import": "./dist/src/proof.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test:compiled": "node --test dist/tests/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iXab3r/EyeAuras.CliFactory.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/iXab3r/EyeAuras.CliFactory/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/iXab3r/EyeAuras.CliFactory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
