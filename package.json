{
  "name": "ai-cli-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript factory for consistent, AI-friendly command-line integrations.",
  "workspaces": [
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "bootstrap": "dotnet run --file scripts/bootstrap.cs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build",
    "test": "npm run build && npm run test:compiled --workspaces --if-present",
    "check": "npm run test",
    "teamcity": "npm run start --workspace @eyeauras/teamcity-cli --",
    "random-rest": "npm run start --workspace @eyeauras/random-rest-cli --",
    "random-pw": "npm run start --workspace @eyeauras/random-pw-cli --",
    "browser:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.4.2",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
